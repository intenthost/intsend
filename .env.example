# ──────────────────────────────────────────────
# Intent Mail — Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── API Security ──────────────────────────────
# Generate with: openssl rand -hex 32
API_KEY=your_secret_api_key_here

# ── Allowed Sender Domain (wildcard) ──────────
# Any *@this-domain will be accepted as From
# e.g.  noreply@acme.com, hello@acme.com, etc.
ALLOWED_DOMAIN=yourdomain.com

# ── cPanel SMTP ───────────────────────────────
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@yourdomain.com
SMTP_PASSWORD=your_cpanel_email_password
SMTP_ENCRYPTION=tls
# Options: tls | ssl | (empty for none)

# ── Debug (set to 1 to log SMTP traffic) ──────
SMTP_DEBUG=0

